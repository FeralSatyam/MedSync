# Comma-separated list of allowed browser origins (CORS). Include local dev and production frontend.
# The first URL is used when building pharmacist QR links — put production first if both are listed.
# Example: CLIENT_URL=https://your-app.vercel.app,http://localhost:5173
CLIENT_URL=https://med-sync-lyart.vercel.app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=MedSync <your_email@gmail.com>
